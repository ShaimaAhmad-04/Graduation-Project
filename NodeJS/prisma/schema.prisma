generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  firstName   String  @db.VarChar(50)
  lastName    String? @db.VarChar(50)
  email       String  @unique @db.VarChar(255)
  password    String  @db.VarChar(255)
  phoneNumber String  @db.VarChar(20)
  role        Int

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  company Company?
  student Student?
}

model Student {
  userId             Int                 @id
  major              String?
  university         String?             @db.VarChar(100)
  experience         String?
  gpa                Decimal?
  graduationYear     Int?
  linkedinUrl        String?             @db.VarChar(255)
  githubUrl          String?             @db.VarChar(255)
  certifications     String[]
  cvUrl              String?
  applications       Application[]
  roadmaps           Roadmap[]
  user               User                @relation(fields: [userId], references: [id])
  studentInternships StudentInternship[]
  studentSkills      StudentSkill[]
}

model Company {
  userId      Int           @id
  name        String
  industry    String?
  website     String?
  status      CompanyStatus @default(pending)
  description String?
  location    String?       @db.VarChar(255)
  user        User          @relation(fields: [userId], references: [id])
  internships Internship[]
}

model Skill {
  id               Int               @id @default(autoincrement())
  name             String            @unique @db.VarChar(100)
  internshipSkills InternshipSkill[]
  studentSkills    StudentSkill[]
}

model Internship {
  id                  Int                  @id @default(autoincrement())
  companyId           Int
  title               String               @db.VarChar(150)
  description         String?
  postDate            DateTime
  submissionDeadline  DateTime
  duration            String?              @db.VarChar(50)
  isPaid              Boolean
  status              Boolean
  applications        Application[]
  company             Company              @relation(fields: [companyId], references: [userId])
  location            String?              @db.VarChar(255)
  internshipSkills    InternshipSkill[]
  studentInternships  StudentInternship[]
}

model InternshipSkill {
  internshipId  Int
  skillId       Int
  matchingScore Int?
  date          DateTime?
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill         Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([internshipId, skillId])
}

model Application {
  id            Int        @id @default(autoincrement())
  studentId     Int
  internshipId  Int
  status        Int        @default(0)
  matchingScore Int?
  createdAt     DateTime   @default(now())
  internship    Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [studentId], references: [userId], onDelete: Cascade)
}

model Roadmap {
  roadmapId       Int           @id @default(autoincrement())
  studentId       Int
  desiredPosition String?       @db.VarChar(100)
  generatedAt     DateTime?
  student         Student       @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  nodes           RoadmapNode[]
}

model RoadmapNode {
  nodeId     Int
  roadmapId  Int
  title      String  @db.VarChar(150)
  orderIndex Int
  roadmap    Roadmap @relation(fields: [roadmapId], references: [roadmapId], onDelete: Cascade)

  @@id([nodeId, roadmapId])
}

model StudentInternship {
  studentId    Int
  internshipId Int
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, internshipId])
}

model StudentSkill {
  studentId  Int
  skillId    Int
  experience Int?
  skill      Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([studentId, skillId])
}

enum CompanyStatus {
  verified
  pending
  unverified
}
